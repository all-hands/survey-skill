    "QuestionID": "QID9",
    "QuestionJS": "Qualtrics.SurveyEngine.addOnReady(function () {\n  var lines = [\n    'BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//Example Org//Sample//EN', 'METHOD:PUBLISH',\n    'BEGIN:VEVENT', 'UID:lunch-talk-20270318@example.org', 'DTSTAMP:20261026T120000Z',\n    'DTSTART:20270318T120000Z', 'DTEND:20270318T130000Z',\n    'SUMMARY:Lunch talk', 'LOCATION:Room A', 'END:VEVENT', 'END:VCALENDAR'\n  ];\n  var url = URL.createObjectURL(new Blob([lines.join('\\r\\n') + '\\r\\n'], { type: 'text/calendar' }));\n  Array.prototype.forEach.call(this.getQuestionContainer().querySelectorAll('a.ics-link'), function (a) {\n    a.href = url;\n  });\n});"
   }
