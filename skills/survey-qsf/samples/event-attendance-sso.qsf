   "SecondaryAttribute": "Save the date Add it to your calendar now, whatever you answered above. Google Calendar Outlook D...",
   "TertiaryAttribute": null,
   "Payload": {
    "QuestionText": "<div class=\"card\" style=\"background:#fff;border:1px solid #d9e1e8;border-left:6px solid #0f766e;border-radius:6px;padding:20px 22px;font-family:Arial,Helvetica,sans-serif;color:#1f2a37;line-height:1.6\">\n<h3 style=\"font-family:Arial,sans-serif;font-size:20px;color:#1f2a37;margin:0 0 8px\">Save the date</h3>\n<p style=\"font-family:Arial,sans-serif;color:#55606e\">Add it to your calendar now, whatever you answered above.</p>\n<div><a href=\"https://calendar.google.com/calendar/render?action=TEMPLATE&amp;text=Lunch+talk&amp;dates=20270318T120000Z%2F20270318T130000Z&amp;ctz=UTC&amp;location=Room+A\" rel=\"noopener\" target=\"_blank\" style=\"display:inline-block;margin:4px 10px 4px 0;padding:10px 16px;border:1px solid #0f766e;border-radius:4px;text-decoration:none;font-weight:600;font-size:15px;background:#0f766e;color:#fff\">Google Calendar</a><a href=\"https://outlook.office.com/calendar/0/deeplink/compose?path=%2Fcalendar%2Faction%2Fcompose&amp;rru=addevent&amp;subject=Lunch+talk&amp;startdt=2027-03-18T12%3A00%3A00Z&amp;enddt=2027-03-18T13%3A00%3A00Z&amp;location=Room+A\" rel=\"noopener\" target=\"_blank\" style=\"display:inline-block;margin:4px 10px 4px 0;padding:10px 16px;border:1px solid #0f766e;border-radius:4px;text-decoration:none;font-weight:600;font-size:15px;background:#fff;color:#0f766e\">Outlook</a><a class=\"ics-link\" download=\"lunch-talk.ics\" href=\"#\" style=\"display:inline-block;margin:4px 10px 4px 0;padding:10px 16px;border:1px solid #0f766e;border-radius:4px;text-decoration:none;font-weight:600;font-size:15px;background:#fff;color:#0f766e\">Download .ics</a></div>\n<p style=\"font-size:13px;color:#55606e\">Then press <strong>Done</strong>.</p>\n</div>",
    "DataExportTag": "save_the_date",
    "QuestionType": "DB",
    "Selector": "TB",
    "DataVisibility": {
     "Private": false,
     "Hidden": false
    },
    "Configuration": {
     "QuestionDescriptionOption": "UseText"
    },
    "QuestionDescription": "Save the date Add it to your calendar now, whatever you answered above. Google Calendar Outlook D...",
